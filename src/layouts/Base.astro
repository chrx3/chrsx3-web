---
/* Esqueleto común de la portada y las fichas: head, pill de navegación, trama
   de fondo y pie. Sin ClientRouter: cada página es una carga normal, así los
   scripts corren una sola vez y no hay que limpiar listeners entre vistas. */
import '@fontsource/schibsted-grotesk/400.css'
import '@fontsource/schibsted-grotesk/500.css'
import '@fontsource/schibsted-grotesk/700.css'
import '@fontsource/schibsted-grotesk/800.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'
import { meta } from '../data/site'

type NavItem = { href: string; label: string; id?: string; cta?: boolean; optional?: boolean }

interface Props {
  title: string
  description: string
  /** Ruta canónica, con barra final (p. ej. «/trabajo/atic/») */
  path: string
  ogType?: 'website' | 'article'
  ogTitle?: string
  /** En la portada los enlaces son anclas; en las fichas apuntan a la portada */
  nav: NavItem[]
}

const { title, description, path, ogType = 'website', ogTitle = title, nav } = Astro.props
const url = new URL(path, Astro.site).href
const year = new Date().getFullYear()

/* La pill en negro con el punto cobalto de la marca. En línea: cero peticiones. */
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='16' fill='%230f1115'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%238f97ff'/%3E%3C/svg%3E"
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta name="theme-color" content="#f1f2f4" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <canvas id="trama" aria-hidden="true"></canvas>

    <nav class="pill" id="pill" aria-label="Principal">
      <svg class="pill-shape" aria-hidden="true" focusable="false"><path id="pill-path"></path></svg>
      <a class="brand" href="/" aria-label="chrsx3, inicio">chrsx3<span>.</span></a>
      {
        nav.map((item) => (
          <a class:list={[item.cta && 'cta', item.optional && 'opt']} href={item.href} data-nav={item.id}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <main id="contenido">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap mono">
        <span>© {year} {meta.name} · Santiago</span>
        <span>Hecho con Claude, en mi servidor</span>
      </div>
    </footer>

    <script>
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches

      /* ---------- trama de fondo ----------
         Puntos halftone que se cargan en dos esquinas y se pierden hacia el
         centro, para no pasar nunca bajo el texto. Bajo el cursor la trama se
         revela un poco, como una lupa. Las secciones oscuras y las tarjetas la tapan. */
      const tc = document.getElementById('trama') as HTMLCanvasElement | null
      const g = tc?.getContext('2d')
      if (tc && g) {
        const CELL = 14, MAXR = 2.6, LENS = 150, LENSR = 2.2
        const hover = matchMedia('(hover: hover) and (pointer: fine)').matches && !calm
        let w = 0, h = 0, dpr = 1, px = -9999, py = -9999, queued = false
        const ink = getComputedStyle(document.documentElement).getPropertyValue('--trama').trim() || '#c2c7cf'
        const draw = () => {
          queued = false
          g.setTransform(dpr, 0, 0, dpr, 0, 0)
          g.clearRect(0, 0, w, h)
          g.fillStyle = ink
          const R = Math.hypot(w, h) * 0.5
          g.beginPath()
          for (let y = CELL / 2; y < h; y += CELL) {
            for (let x = CELL / 2; x < w; x += CELL) {
              const a = Math.max(0, 1 - Math.hypot(w - x, y) / R) // esquina superior derecha
              const b = Math.max(0, 1 - Math.hypot(x, h - y) / (R * 0.8)) // esquina inferior izquierda
              let r = Math.pow(Math.max(a, b), 1.7) * MAXR
              if (hover) {
                const d = Math.hypot(x - px, y - py)
                if (d < LENS) r += Math.pow(1 - d / LENS, 2) * LENSR
              }
              if (r < 0.35) continue
              g.moveTo(x + r, y)
              g.arc(x, y, r, 0, Math.PI * 2)
            }
          }
          g.fill()
        }
        const queue = () => {
          if (!queued) { queued = true; requestAnimationFrame(draw) }
        }
        const size = () => {
          dpr = Math.min(window.devicePixelRatio || 1, 2)
          w = window.innerWidth
          h = window.innerHeight
          tc.width = Math.round(w * dpr)
          tc.height = Math.round(h * dpr)
          draw()
        }
        window.addEventListener('resize', size)
        if (hover) {
          window.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; queue() }, { passive: true })
          document.addEventListener('pointerleave', () => { px = py = -9999; queue() })
        }
        size()
      }

      /* ---------- pill: notch arriba, flotante al bajar ----------
         El fondo es UNA sola forma SVG (cuerpo + esquinas invertidas) que se
         transforma cuadro a cuadro: no hay piezas separadas que dejen ver uniones.
         t = 0: notch. t = 1: pill flotante. En la primera mitad se recogen las
         esquinas invertidas; en la segunda se redondea el borde superior. */
      const pill = document.getElementById('pill')
      const pillPath = document.getElementById('pill-path')
      if (pill && pillPath) {
        const EAR = 16, LIFT = 16, DUR = 320
        let W = 0, H = 0, t = 0, from = 0, to = 0, t0 = 0, raf = 0
        const clamp = (v: number) => Math.max(0, Math.min(1, v))
        const ease = (x: number) => 1 - Math.pow(1 - x, 3)
        const paint = () => {
          const o = EAR, r = H / 2
          const e = EAR * (1 - clamp(t * 2))
          const rt = r * clamp(t * 2 - 1)
          const rb = Math.min(r, 24 + (r - 24) * t)
          const d = [
            `M${o - e + rt},0`,
            `L${o + W + e - rt},0`,
            e > 0 ? `A${e},${e} 0 0 0 ${o + W},${e}` : `A${rt},${rt} 0 0 1 ${o + W},${rt}`,
            `L${o + W},${H - rb}`,
            `A${rb},${rb} 0 0 1 ${o + W - rb},${H}`,
            `L${o + rb},${H}`,
            `A${rb},${rb} 0 0 1 ${o},${H - rb}`,
            `L${o},${e > 0 ? e : rt}`,
            e > 0 ? `A${e},${e} 0 0 0 ${o - e},0` : `A${rt},${rt} 0 0 1 ${o + rt},0`,
            'Z',
          ].join(' ')
          pillPath.setAttribute('d', d)
          pill.style.setProperty('--pill-y', `${(LIFT * t).toFixed(2)}px`)
          pill.style.setProperty('--pill-shadow', (0.18 * t).toFixed(3))
        }
        const measure = () => { W = pill.offsetWidth; H = pill.offsetHeight; paint() }
        const step = (now: number) => {
          const k = clamp((now - t0) / DUR)
          t = from + (to - from) * ease(k)
          paint()
          raf = k < 1 ? requestAnimationFrame(step) : 0
        }
        const go = (target: number) => {
          if (target === to && (raf || t === target)) return
          to = target
          cancelAnimationFrame(raf)
          if (calm) { t = target; paint(); raf = 0; return }
          from = t
          t0 = performance.now()
          raf = requestAnimationFrame(step)
        }
        let ticking = false
        window.addEventListener('scroll', () => {
          if (ticking) return
          ticking = true
          requestAnimationFrame(() => { go(window.scrollY < 24 ? 0 : 1); ticking = false })
        }, { passive: true })
        if ('ResizeObserver' in window) new ResizeObserver(measure).observe(pill)
        t = to = window.scrollY < 24 ? 0 : 1
        measure()
        document.fonts?.ready.then(measure)
      }

      /* ---------- pill: marca la sección visible (solo en la portada) ---------- */
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.pill [data-nav]')]
      const sections = links.map((a) => document.getElementById(a.dataset.nav ?? '')).filter((el): el is HTMLElement => !!el)
      if ('IntersectionObserver' in window && sections.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return
            links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.nav === e.target.id)))
          })
        }, { rootMargin: '-45% 0px -50% 0px' })
        sections.forEach((s) => io.observe(s))
      }
    </script>
  </body>
</html>
