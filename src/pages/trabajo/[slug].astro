---
import { Picture } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import { work } from '../../data/site'

export function getStaticPaths() {
  return work.map((project, i) => ({
    params: { slug: project.slug },
    /* El siguiente da la vuelta al final: la ficha nunca queda sin salida */
    props: { project, index: i, next: work[(i + 1) % work.length], nextIndex: (i + 1) % work.length },
  }))
}

const { project, index, next, nextIndex } = Astro.props
const pad = (n: number) => String(n).padStart(2, '0')

/* Solo se listan los datos que estén escritos en site.ts. Sin relleno. */
const facts = [
  { k: project.hostLabel ?? 'Sitio', v: project.host },
  project.year && { k: 'Año', v: project.year },
  project.role && { k: 'Rol', v: project.role },
  project.stack?.length && { k: 'Stack', v: project.stack.join(' · ') },
].filter(Boolean) as { k: string; v: string }[]

const title = `${project.name} — ${project.tag} · Christian Alcántara`
const cta = project.cta ?? `Abrir ${project.host}`
const shotNote = project.shotNote ?? 'Captura completa del sitio en producción'

const nav = [
  { href: '/#trabajo', label: '← Trabajo', keep: true },
  { href: '/#contacto', label: 'Hablemos', cta: true },
]
---

<Base
  title={title}
  ogTitle={`${project.name} — ${project.tag}`}
  description={project.line}
  path={`/trabajo/${project.slug}/`}
  ogType="article"
  nav={nav}
>
  <section class="wrap grid-12 case-head" aria-labelledby="h-case">
    <div class="case-meta">
      <p class="label">Ficha {pad(index + 1)} / {pad(work.length)}</p>
      <dl>
        {
          facts.map((f) => (
            <div>
              <dt class="label">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="case-main">
      <p class="label">{project.tag}</p>
      <h1 class="case-title" id="h-case" transition:name={`name-${project.slug}`}>{project.name}</h1>
      <p class="case-line">{project.line}</p>
      {project.detail && <p class="case-detail">{project.detail}</p>}

      <div class="btns">
        {
          project.downloads?.map((d) => (
            <a class="btn btn-solid" href={d.url} target="_blank" rel="noopener">
              {d.label} <span class="arrow" aria-hidden="true">↓</span>
            </a>
          ))
        }
        <a
          class:list={['btn', project.downloads?.length ? 'btn-line' : 'btn-solid']}
          href={project.url}
          target="_blank"
          rel="noopener"
        >
          {cta} <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {
    project.features?.length ? (
      <section class="wrap grid-12 case-sec" aria-label="Qué hace">
        <p class="label">Qué hace</p>
        <div class="case-body">
          <ul class="feats">
            {project.features.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  <!-- La captura completa: la que el visor de la portada recorre, acá entera -->
  <section class="wrap grid-12 case-sec" aria-label="Captura">
    <p class="label">Captura</p>
    <div class="case-body">
      <figure>
        <div class="shot-wrap">
          <div class="chrome"><i></i><i></i><i></i><span>{project.host}</span></div>
          <div class="shot">
            <Picture
              src={project.shot}
              formats={['avif', 'webp']}
              widths={[720, 1080, 1440]}
              sizes="(min-width: 1440px) 1000px, (min-width: 901px) 70vw, calc(100vw - 2rem)"
              alt={`Captura de ${project.name}`}
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
        <figcaption class="label case-note">{shotNote}</figcaption>
      </figure>

      {
        project.gallery?.map((item) => (
          <figure>
            <div class="shot">
              <Picture
                src={item.src}
                formats={['avif', 'webp']}
                widths={[720, 1080]}
                sizes="(min-width: 1440px) 1000px, (min-width: 901px) 70vw, calc(100vw - 2rem)"
                alt={item.caption}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="label case-note">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <nav class="wrap case-next" aria-label="Siguiente proyecto">
    <div class="row">
      <a class="row-link" href={`/trabajo/${next.slug}/`}>
        <span class="no">{pad(nextIndex + 1)}</span>
        <span class="nm">{next.name}</span>
        <span class="host" aria-hidden="true">→</span>
        <span class="kind">Siguiente proyecto · {next.tag}</span>
      </a>
    </div>
  </nav>

  <a slot="foot" href="/#contacto">Hablemos →</a>
</Base>
