---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import { meta, work, services, stack } from '../data/site'

const featured = work.find((w) => w.featured) ?? work[0]
const pad = (n: number) => String(n).padStart(2, '0')
const mail = `mailto:${meta.email}?subject=${encodeURIComponent('Proyecto — desde chrsx3.com')}`

/* El orden de site.ts es la numeración del índice. Una captura más baja que el
   marco del visor (una sola pantalla, no una página) se muestra quieta. */
const rows = work.map((w, i) => ({
  ...w,
  no: pad(i + 1),
  kind: [w.tag, w === featured && 'Destacado', w.year].filter(Boolean).join(' · '),
  still: w.shot.height / w.shot.width < 1.2,
}))

const nav = [
  { href: '#trabajo', label: 'Trabajo' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#perfil', label: 'Perfil' },
  { href: '#stack', label: 'Stack' },
  { href: '#contacto', label: 'Hablemos', cta: true },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: meta.name,
  alternateName: meta.alias,
  jobTitle: 'Ingeniero de software',
  email: `mailto:${meta.email}`,
  url: 'https://chrsx3.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  sameAs: [meta.linkedin, meta.github],
}
---

<Base
  title="Christian Alcántara — Ingeniero de software · Santiago de Chile"
  ogTitle="Christian Alcántara — Ingeniero de software"
  description={meta.description}
  path="/"
  nav={nav}
  cat
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ===== portada ===== -->
  <section class="wrap grid-12 hero" aria-labelledby="h-hero">
    <div class="hero-meta">
      <p class="label">00 — Ficha</p>
      <dl>
        <div>
          <dt class="label">Nombre</dt>
          <dd>{meta.name}</dd>
        </div>
        <div>
          <dt class="label">Alias</dt>
          <dd>{meta.alias}</dd>
        </div>
        <div>
          <dt class="label">Base</dt>
          <dd>{meta.city}</dd>
        </div>
        <div class="wide-only">
          <dt class="label">Enfoque</dt>
          <dd>Sitios · Sistemas · Móvil</dd>
        </div>
        <div class="wide-only">
          <dt class="label">Destacado</dt>
          <dd><a href={`#p-${featured.slug}`}>{featured.name}, {featured.tag.toLowerCase()}</a></dd>
        </div>
      </dl>
    </div>

    <h1 class="hero-title" id="h-hero">
      <span class="line"><span style="--i: 0">Construyo software</span></span>
      <span class="line ind"><span style="--i: 1">para empresas</span></span>
      <span class="line"><span style="--i: 2">y lo mantengo</span></span>
      <span class="line ind"
        ><span style="--i: 3" class="ink">corriendo<span class="caret" aria-hidden="true"></span></span
      ></span>
    </h1>

    <div class="hero-foot">
      <p class="hero-sub">
        Sitios, sistemas internos y aplicaciones móviles. Hablás directo con quien escribe el código, y
        lo dejo andando en servidor propio.
      </p>
      <div class="btns">
        <a class="btn btn-solid" href={mail}>Escribime por correo <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn-line" href="#trabajo">Ver el índice <span class="arrow" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <!-- ===== tira: todos los proyectos, arriba del pliegue ===== -->
  <nav class="strip" aria-label="Proyectos">
    <ol>
      {
        rows.map((w, i) => (
          <li style={`--i: ${i}`}>
            <a href={`#p-${w.slug}`}>
              <span class="cap">
                <b>{w.no}</b>
                <span>{w.tag}</span>
              </span>
              <span class="thumb">
                <Picture
                  src={w.shotTop}
                  formats={['avif', 'webp']}
                  widths={[380, 760]}
                  sizes="(max-width: 900px) 68vw, (min-width: 1440px) 230px, 16vw"
                  alt=""
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </span>
              <span class="nm">{w.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- ===== trabajo ===== -->
  <section class="wrap section" id="trabajo" aria-labelledby="h-trabajo">
    <header class="grid-12 sec-head">
      <p class="label">01 — Índice · {work.length} proyectos</p>
      <h2 id="h-trabajo">Trabajo</h2>
    </header>

    <div class="grid-12 work">
      <ol class="index">
        {
          rows.map((w, i) => (
            <li
              class:list={['row', i === 0 && 'is-on']}
              id={`p-${w.slug}`}
              data-shot={w.slug}
              data-host={w.host}
              data-no={w.no}
            >
              <a class="row-link" href={`/trabajo/${w.slug}/`}>
                <span class="no">{w.no}</span>
                <span class="nm" transition:name={`name-${w.slug}`}>
                  {w.name}
                </span>
                <span class="host">{w.host}</span>
                <span class="kind">{w.kind}</span>
                <span class="line">{w.line}</span>
                <span class="mthumb">
                  <Picture
                    src={w.shotTop}
                    formats={['avif', 'webp']}
                    widths={[380, 760]}
                    sizes="(max-width: 1000px) calc(100vw - 6rem), 760px"
                    alt={`Captura de ${w.name}`}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </a>

              {w.features?.length ? (
                <div class="feat">
                  {w.detail && <p class="feat-detail">{w.detail}</p>}

                  {w.stack?.length ? (
                    <ul class="chips" aria-label={`Stack de ${w.name}`}>
                      {w.stack.map((s) => (
                        <li>{s}</li>
                      ))}
                      {w.role && <li>Rol: {w.role}</li>}
                    </ul>
                  ) : null}

                  <ul class="feats">
                    {w.features.map((f) => (
                      <li>
                        <h3>{f.title}</h3>
                        <p>{f.body}</p>
                      </li>
                    ))}
                  </ul>

                  <div class="btns">
                    {w.downloads?.map((d) => (
                      <a class="btn btn-solid" href={d.url} target="_blank" rel="noopener">
                        {d.label} <span class="arrow" aria-hidden="true">↓</span>
                      </a>
                    ))}
                    <a class="btn btn-line" href={w.url} target="_blank" rel="noopener">
                      {w.cta ?? `Abrir ${w.host}`} <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                  </div>
                  {w.shotNote && <p class="label note">{w.shotNote}</p>}
                </div>
              ) : null}
            </li>
          ))
        }
      </ol>

      <!-- Decorativo: repite lo que ya dice cada fila, por eso queda fuera del árbol
           accesible. Solo existe en escritorio: en móvil está en display:none y sus
           imágenes lazy nunca se piden. -->
      <figure class="viewer" aria-hidden="true">
        <div class="chrome"><i></i><i></i><i></i><output id="viewer-host">{rows[0].host}</output></div>
        <div class="viewer-frame">
          {
            rows.map((w, i) => (
              <Picture
                src={w.shot}
                formats={['avif', 'webp']}
                widths={[560, 1120]}
                sizes="(min-width: 1440px) 556px, 39vw"
                alt=""
                loading="lazy"
                decoding="async"
                class:list={[i === 0 && 'is-on', w.still && 'is-still']}
                data-shot={w.slug}
              />
            ))
          }
        </div>
        <figcaption class="label">
          <span id="viewer-cap">{rows[0].still ? 'Captura de pantalla' : 'Captura de página completa'}</span>
          <span id="viewer-no">{rows[0].no} / {pad(rows.length)}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== servicios ===== -->
  <section class="on-cobalt" id="servicios" aria-labelledby="h-servicios">
    <div class="wrap section">
      <header class="grid-12 sec-head">
        <p class="label">02 — Servicios</p>
        <h2 id="h-servicios">Qué hago</h2>
      </header>

      <ol class="services">
        {
          services.map((s, i) => (
            <li class="service">
              <span class="idx" aria-hidden="true">{pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="direct">Hablás directo con quien escribe el código.</p>
    </div>
  </section>

  <!-- ===== perfil ===== -->
  <section class="wrap section" id="perfil" aria-labelledby="h-perfil">
    <header class="grid-12 sec-head">
      <p class="label">03 — Perfil</p>
      <h2 id="h-perfil">Sobre mí</h2>
    </header>

    <div class="grid-12 profile">
      <dl class="sheet-aside">
        <div class="sheet-row">
          <dt class="label">Primero</dt>
          <dd>Diseño gráfico · Liceo Tecnológico Enrique Kirberg</dd>
        </div>
        <div class="sheet-row">
          <dt class="label">Después</dt>
          <dd>Ingeniería Informática · Duoc UC</dd>
        </div>
        <div class="sheet-row">
          <dt class="label">Desde 2023</dt>
          <dd>Full-stack · TSG Environmental Chile</dd>
        </div>
        <div class="sheet-row">
          <dt class="label">En paralelo</dt>
          <dd>Clientes propios · servidor propio</dd>
        </div>
      </dl>

      <div class="sheet-main profile-text">
        <p>
          Me llamo <strong>{meta.name}</strong> y vivo en Santiago. Estudié
          <strong>diseño gráfico</strong> en el Liceo Tecnológico Enrique Kirberg y después
          <strong>Ingeniería Informática en Duoc UC</strong>. Esa mezcla es la razón de que me importe
          tanto cómo se ve un sistema como si se cae.
        </p>
        <p>
          Desde 2023 trabajo como <strong>desarrollador full-stack en TSG Environmental Chile</strong>, en
          un equipo de dos personas del área de Innovación y Desarrollo. Revivo sistemas heredados, levanto
          aplicaciones móviles y sostengo un volumen alto de proyectos con React, Next.js y Python.
        </p>
        <p>
          En paralelo llevo mis propios clientes y proyectos. Administro el servidor donde corren:
          dominios, certificados, despliegues y monitoreo.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== stack ===== -->
  <section class="wrap section" id="stack" aria-labelledby="h-stack">
    <header class="grid-12 sec-head">
      <p class="label">04 — Especificaciones</p>
      <h2 id="h-stack">Stack</h2>
    </header>

    <div class="grid-12 spec">
      <p class="sheet-aside spec-intro">{meta.description}</p>
      <dl class="sheet-main">
        {
          Object.entries(stack).map(([group, items]) => (
            <div class="sheet-row">
              <dt class="label">{group}</dt>
              <dd>
                {items.map((item) => (
                  <span>{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ===== contacto ===== -->
  <section class="contact" id="contacto" aria-labelledby="h-contacto">
    <div class="wrap section">
      <header class="grid-12 sec-head">
        <p class="label">05 — Contacto</p>
        <h2 id="h-contacto">Contame qué necesitás.</h2>
      </header>

      <a class="big-cta" href={mail}
        ><span class="ink">Hablemos</span> <span class="arrow" aria-hidden="true">↗</span><span class="sr-only">
          por correo</span
        ></a
      >

      <ul class="channels">
        <li>
          <a href={mail}>
            <span class="label">Correo</span>
            <span class="v">{meta.email}</span>
          </a>
        </li>
        <li>
          <a href={meta.linkedin} target="_blank" rel="noopener">
            <span class="label">LinkedIn</span>
            <span class="v">{meta.name} ↗</span>
          </a>
        </li>
        <li>
          <a href={meta.github} target="_blank" rel="noopener">
            <span class="label">GitHub</span>
            <span class="v">{meta.github.replace('https://github.com/', '')} ↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>
