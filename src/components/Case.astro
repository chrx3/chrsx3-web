---
/* La ficha de un proyecto, en cualquier idioma. La renderizan
   src/pages/trabajo/[slug].astro (es) y src/pages/en/trabajo/[slug].astro (en). */
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import { getSite } from '../data/site.en'
import { ui, fill, pathFor, type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
  slug: string
}

const { lang, slug } = Astro.props
const t = ui[lang]
const c = t.case
const { work } = getSite(lang)

const i = work.findIndex((w) => w.slug === slug)
const project = work[i]
/* El siguiente da la vuelta al final: la ficha nunca queda sin salida */
const next = work[(i + 1) % work.length]

/* Solo se listan los datos que estén escritos en site.ts. Sin relleno. */
const facts = [
  { k: project.hostLabel ?? c.site, v: project.host },
  project.year && { k: c.year, v: project.year },
  project.role && { k: c.role, v: project.role },
  project.stack?.length && { k: c.stack, v: project.stack.join(' · ') },
].filter(Boolean) as { k: string; v: string }[]

const title = `${project.name} — ${project.tag} · Christian Alcántara`
const cta = project.cta ?? fill(c.open, { host: project.host })
const shotNote = project.shotNote ?? c.shotNote
const external = !project.url.startsWith('mailto:')
const ext = { target: '_blank', rel: 'noopener' }
const isPortrait = (img: ImageMetadata) => img.height > img.width
const home = pathFor(lang, '/')

const nav = [
  { href: `${home}#atic`, label: t.nav.atic },
  { href: `${home}#proyectos`, label: t.nav.projects },
  { href: `${home}#clientes`, label: t.nav.clients, optional: true },
  { href: `${home}#contacto`, label: t.nav.contact, cta: true },
]
---

<Base
  title={title}
  ogTitle={`${project.name} — ${project.tag}`}
  description={project.line}
  path={`/trabajo/${project.slug}/`}
  lang={lang}
  ogType="article"
  nav={nav}
>
  <article class="wrap case" aria-labelledby="h-case">
    <header class="case-head">
      <a class="mono case-back" href={`${home}${project.client ? '#clientes' : '#proyectos'}`}>{c.back}</a>
      <p class="mono kicker">{project.tag}</p>
      <h1 id="h-case">{project.name}</h1>
      <p class="case-line">{project.line}</p>
      {project.detail && <p class="case-detail">{project.detail}</p>}

      <div class="od-cluster case-actions">
        {
          project.downloads?.map((d) => (
            <a class="btn btn-solid" href={d.url} {...ext}>
              {d.label}
            </a>
          ))
        }
        <a class:list={['btn', project.downloads?.length ? 'btn-line' : 'btn-solid']} href={project.url} {...(external ? ext : {})}>
          {cta}
        </a>
        {
          project.docs && (
            <a class="btn btn-line" href={project.docs} {...ext}>
              {c.docs}
            </a>
          )
        }
      </div>

      <dl class="case-facts">
        {
          facts.map((f) => (
            <div>
              <dt class="mono">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    {
      project.story?.length ? (
        <section class="case-sec" aria-labelledby="h-historia">
          <h2 id="h-historia">{c.story}</h2>
          <ol class="case-story">
            {project.story.map((s) => (
              <li>
                <p class="mono kicker">{s.label}</p>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </section>
      ) : null
    }

    {
      project.highlights?.length || project.features?.length ? (
        <section class="case-sec" aria-labelledby="h-que">
          <h2 id="h-que">{c.what}</h2>
          {project.features?.length ? (
            <ul class="feats">
              {project.features.map((f) => (
                <li>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </li>
              ))}
            </ul>
          ) : (
            <ul class="case-bits">
              {project.highlights?.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ) : null
    }

    {
      project.video && (
        <section class="case-sec" aria-labelledby="h-video">
          <h2 id="h-video">{c.video}</h2>
          <div class="trailer">
            <video class="h" src={project.video.src} poster={project.video.poster} width="1280" height="720" controls preload="none" playsinline aria-label={project.video.label} />
            {project.video.vertical && (
              <video class="v" src={project.video.vertical} poster={project.video.verticalPoster} width="720" height="1280" controls preload="none" playsinline aria-label={`${project.video.label}, ${c.vertical}`} />
            )}
          </div>
        </section>
      )
    }

    <section class="case-sec" aria-labelledby="h-capturas">
      <h2 id="h-capturas">{c.shots}</h2>
      <div class="case-gallery">
        <figure>
          <div class:list={['shot', isPortrait(project.shot) && 'portrait']}>
            <Picture
              src={project.shot}
              formats={['avif', 'webp']}
              widths={[720, 1080, 1440].filter((w) => w <= project.shot.width).concat(project.shot.width < 720 ? [project.shot.width] : [])}
              sizes="(min-width: 1280px) 1180px, calc(100vw - 2rem)"
              alt={fill(c.shotOf, { name: project.name })}
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="mono">{shotNote}</figcaption>
        </figure>

        {
          project.gallery?.map((item) => (
            <figure>
              <div class:list={['shot', isPortrait(item.src) && 'portrait']}>
                <Picture
                  src={item.src}
                  formats={['avif', 'webp']}
                  widths={[720, 1080].filter((w) => w <= item.src.width).concat(item.src.width < 720 ? [item.src.width] : [])}
                  sizes="(min-width: 1280px) 580px, (min-width: 768px) 50vw, calc(100vw - 2rem)"
                  alt={item.caption}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mono">{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <a class="case-next" href={pathFor(lang, `/trabajo/${next.slug}/`)}>
      <span class="od-field">
        <span class="mono">{c.next} · {next.tag}</span>
        <strong>{next.name}</strong>
      </span>
      <span aria-hidden="true">→</span>
    </a>
  </article>
</Base>
